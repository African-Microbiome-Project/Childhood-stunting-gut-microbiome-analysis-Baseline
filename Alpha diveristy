#Load libraries
library(phyloseq)
library(ggplot2)
library(ggpubr)
library(patchwork)

# 1. Load rarefied phyloseq object (informal dataset)

ps <- readRDS("C:/Users/kayle/Combined_Sep_data/Kaylee results/Merged_rarefied_Informal.rds")

# 2. Calculate alpha diversity measures

alpha_df <- estimate_richness(ps, measures = c("Shannon", "Simpson", "Observed"))

# Add Stunting_status as factor (desired visual order)
alpha_df$Stunting_status <- factor(sample_data(ps)$Stunting_status,  
                                   levels = c("Stunted", "Non-stunted"))

# 3. Print sample counts per group

cat("Sample counts per group:\n")
print(table(alpha_df$Stunting_status))

# 4. Run Wilcoxon tests + FDR correction

tests <- list(  
  Shannon  = wilcox.test(Shannon ~ Stunting_status, data = alpha_df),  
  Simpson  = wilcox.test(Simpson ~ Stunting_status, data = alpha_df),  
  Observed = wilcox.test(Observed ~ Stunting_status, data = alpha_df)  
)  

# Collect raw p-values
p_values <- sapply(tests, function(x) x$p.value)  

# Apply FDR correction
p_values_fdr <- p.adjust(p_values, method = "BH")  

# 5. Print Wilcoxon and FDR p-values

cat("\nWilcoxon raw p-values:\n")
print(p_values)
cat("\nFDR-corrected p-values (BH):\n")
print(p_values_fdr)

# 6. Define custom palette

custom_palette <- c("Stunted" = "#FFB347", "Non-stunted" = "#B57EDC")

# 7. Plotting function

plot_alpha <- function(df, measure, ylab_text, fdr_p){  
  ggplot(df, aes(x = Stunting_status, y = .data[[measure]], fill = Stunting_status)) +  
    geom_boxplot(color = "black") +  
    geom_jitter(width = 0.2, alpha = 0.7, color = "black") +  
    theme_bw() +  
    scale_fill_manual(values = custom_palette) +  
    labs(y = ylab_text, x = "", fill = "Stunting Status",  
         subtitle = paste0("FDR-corrected p = ", signif(fdr_p, 3))) +  
    theme(  
      axis.title.y = element_text(face = "bold"),  
      axis.text.y  = element_text(face = "bold"),  
      axis.text.x  = element_text(face = "bold", color = "black"),  
      legend.title = element_text(face = "bold"),  
      legend.text  = element_text(face = "bold", color = "black"),  
      plot.subtitle = element_text(face = "italic", color = "black"),  
      panel.grid.major = element_blank(),  
      panel.grid.minor = element_blank()  
    )  
}

# 8. Create output directory

out_dir <- "C:/Users/kayle/Combined_Sep_data/Kaylee results/Results_informal"
if(!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)

# 9. Generate individual plots

p_shannon  <- plot_alpha(alpha_df, "Shannon",  "Shannon Index",  p_values_fdr["Shannon"])
p_simpson  <- plot_alpha(alpha_df, "Simpson",  "Simpson Index",  p_values_fdr["Simpson"])
p_observed <- plot_alpha(alpha_df, "Observed", "Observed Richness", p_values_fdr["Observed"])

#View each plot before saving 

print(p_shannon)
print(p_simpson)
print(p_observed)

#Save individual plots

plots_list <- list(
  Shannon  = p_shannon,
  Simpson  = p_simpson,
  Observed = p_observed
)

for (name in names(plots_list)) {
  ggsave(file.path(out_dir, paste0("alpha_", name, "_Informal.pdf")),
         plots_list[[name]], width = 7, height = 5)
  ggsave(file.path(out_dir, paste0("alpha_", name, "_Informal.png")),
         plots_list[[name]], width = 7, height = 5, dpi = 600)
}

# 10. Combine Shannon, Simpson, Observed with labels A, B, C

combined_plot <- (p_shannon + p_simpson + p_observed) +
  plot_layout(ncol = 3, guides = "collect") &
  theme(legend.position = "right") &
  plot_annotation(tag_levels = "A")  # Adds A, B, C labels

# View combined plot

print(combined_plot)

#Save combined plot

ggsave(file.path(out_dir, "alpha_Shannon_Simpson_Observed_Informal.pdf"),
       combined_plot, width = 18, height = 5)
ggsave(file.path(out_dir, "alpha_Shannon_Simpson_Observed_Informal.png"),
       combined_plot, width = 18, height = 5, dpi = 600)

# 11. Optional: median summary table

aggregate(cbind(Shannon, Simpson, Observed) ~ Stunting_status, data = alpha_df, FUN = median)

