# Genus Level
# 0. Load libraries

library(microeco)
library(ggplot2)
library(dplyr)

# 1. Load microeco object

base_dir <- "C:/Users/kayle/Combined_Sep_data/Kaylee results"
mt <- readRDS(file.path(base_dir, "microeco_rarefied_Informal_mt.rds"))

# 2. Ensure output directory exists

out_dir <- file.path(base_dir, "Informal microecco")
dir.create(out_dir, showWarnings = FALSE)

# 3. Remove NA genera directly from taxonomy table

mt$tax_table <- mt$tax_table[!is.na(mt$tax_table[, "Genus"]), ]
keep_otus <- rownames(mt$tax_table)
mt$otu_table <- mt$otu_table[keep_otus, , drop = FALSE]

# 4. Factor Stunting_status and remove NAs

mt$sample_table <- mt$sample_table[!is.na(mt$sample_table$Stunting_status), ]
mt$sample_table$Stunting_status <- factor(
  mt$sample_table$Stunting_status,
  levels = c("Non-stunted", "Stunted")
)

# 5. Create trans_abund object (top 15 genera, individual samples)

t_genus <- trans_abund$new(
  dataset = mt,
  taxrank = "Genus",
  ntaxa = 15,
  groupmean = NULL  
)

# Re-add Stunting_status for faceting
t_genus$data_abund$Stunting_status <- mt$sample_table$Stunting_status[
  match(t_genus$data_abund$Sample, rownames(mt$sample_table))
]


# 6. Define colors for top 15 genera + Others

taxa_colors_genus <- c(
  "#FC5A8D", "#20B2AA", "#FF8C00", "#800080", "#3CB371",
  "#00008B", "#D291BC", "#556B2F", "#1E90FF", "#8B4513",
  "#FF0000", "#00FF00", "#FF1493", "#FFA07A", "#008080",
  "grey70"  # Others
)


# 7. Generate vertical bar plot for all samples, faceted by Stunting_status

g_genus <- t_genus$plot_bar(
  bar_full = TRUE,
  others_color = "grey70",
  facet = "Stunting_status",
  xtext_keep = FALSE,
  legend_text_italic = FALSE,
  barwidth = 1,             
  color_values = taxa_colors_genus
) +
  theme_classic() +
  theme(
    axis.title.x = element_blank(),
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank(),
    axis.title.y = element_text(size = 16, face = "bold", color = "black"),
    strip.text = element_text(size = 14, face = "bold"),
    legend.title = element_text(face = "bold", size = 14, color = "black"),
    legend.text = element_text(size = 12, color = "black")
  ) +
  labs(
    y = "Relative Abundance (%)",
    legend.title = "Genus"
  )

# 8. Display plot in console

print(g_genus)

# 9. Save plot as PDF and PNG

pdf(file.path(out_dir, "informal_relative_abundance_top15_genus_nospace.pdf"),
    width = 12, height = 6)
print(g_genus)
dev.off()

png(file.path(out_dir, "informal_relative_abundance_top15_genus_nospace.png"),
    width = 12*600, height = 6*600, res = 600)
print(g_genus)
dev.off()

cat("Top 15 genus-level bar plot (no spaces) saved in:", out_dir, "\n")

