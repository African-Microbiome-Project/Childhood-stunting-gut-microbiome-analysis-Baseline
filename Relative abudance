# Relative abudance: Phyla 
# Load libraries
library(microeco)
library(ggplot2)
library(dplyr)

# 1. Load microeco object

base_dir <- "C:/Users/kayle/Combined_Sep_data/Kaylee results"
mt <- readRDS(file.path(base_dir, "microeco_rarefied_Informal_mt.rds"))


# 2. Ensure output directory exists

out_dir <- file.path(base_dir, "Informal microecco")
dir.create(out_dir, showWarnings = FALSE)


# 3. Factor Stunting_status and remove NAs

mt$sample_table <- mt$sample_table[!is.na(mt$sample_table$Stunting_status), ]
mt$sample_table$Stunting_status <- factor(
  mt$sample_table$Stunting_status,
  levels = c("Non-stunted", "Stunted")
)


# 4. Create trans_abund object (top 10 phyla)

t_phylum <- trans_abund$new(
  dataset = mt,
  taxrank = "Phylum",
  ntaxa = 10,
  groupmean = NULL
)


# 5. Recode phylum names to updated taxonomy

recode_map <- c(
  "Firmicutes"         = "Bacillota",
  "Bacteroidetes"      = "Bacteroidota",
  "Actinobacteria"     = "Actinomycetota",
  "Actinobacteriota"   = "Actinomycetota",   # <<< FIX
  "Proteobacteria"     = "Pseudomonadota",
  "Lentisphaerae"      = "Lentisphaerota",
  "Elusimicrobia"      = "Elusimicrobiota",
  "Fusobacteria"       = "Fusobacteriota",
  "Synergistetes"      = "Synergistota",
  "Tenericutes"        = "Mycoplasmatota",
  "Verrucomicrobia"    = "Verrucomicrobiota",
  "Euryarchaeota"      = "Methanobacteriota"
)

t_phylum$data_taxanames <- recode(t_phylum$data_taxanames, !!!recode_map)
t_phylum$data_abund$Taxonomy <- recode(t_phylum$data_abund$Taxonomy, !!!recode_map)


# 5b. Add Stunting_status for faceting

t_phylum$data_abund$Stunting_status <- mt$sample_table$Stunting_status[
  match(t_phylum$data_abund$Sample, rownames(mt$sample_table))
]


# 6. Define colors for top 10 phyla + Others

taxa_colors_phylum <- c(
  "#FC5A8D",
  "#20B2AA",
  "#FF8C00",
  "#800080",
  "#3CB371",
  "#00008B",
  "#D291BC",
  "#556B2F",
  "#1E90FF",
  "#8B4513",
  "grey70"
)


# 7. Generate vertical bar plot

g_phylum <- t_phylum$plot_bar(
  bar_full = TRUE,
  others_color = "grey70",
  facet = "Stunting_status",
  xtext_keep = FALSE,
  legend_text_italic = FALSE,
  barwidth = 1,                 
  color_values = taxa_colors_phylum
) +
  theme_classic() +
  theme(
    axis.title.x = element_blank(),
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank(),
    axis.title.y = element_text(size = 16, face = "bold", color = "black"),
    strip.text = element_text(size = 14, face = "bold"),
    legend.title = element_text(face = "bold", size = 14, color = "black"),
    legend.text = element_text(size = 12, color = "black")
  ) +
  labs(
    y = "Relative Abundance (%)",
    legend.title = "Phylum"
  )

# 8. Display plot

print(g_phylum)


# 9. Save plot

pdf(file.path(out_dir, "informal_relative_abundance_phylum_nospace.pdf"),
    width = 12, height = 6)
print(g_phylum)
dev.off()

png(file.path(out_dir, "informal_relative_abundance_phylum_nospace.png"),
    width = 12*600, height = 6*600, res = 600)
print(g_phylum)
dev.off()

cat("Phylum bar plot (no spaces) saved in:", out_dir, "\n")


