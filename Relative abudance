library(dplyr)
library(openxlsx)  

# 1. Calculate mean relative abundance per Stunting_status
phylum_percent_table <- phylum_abund %>%
  group_by(Stunting_status, Phylum = Taxonomy) %>%
  summarise(
    Mean_RelAbund = mean(Abundance, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(Stunting_status, desc(Mean_RelAbund))

# 2. Print to console
print(phylum_percent_table, n = Inf)

# 3. Save as Excel
out_file <- file.path(base_dir, "Phylum_Mean_RelAbund.xlsx")
write.xlsx(phylum_percent_table, out_file)

