# ================================================================
# 4. Convert to relative abundance (%)
# ================================================================
ps_genus_relab <- transform_sample_counts(ps_genus, function(x) (x / sum(x)) * 100)

# ================================================================
# 5. Extract OTU table
# ================================================================
genus_table <- as.data.frame(otu_table(ps_genus_relab))

# Ensure samples are rows
if (taxa_are_rows(ps_genus_relab)) {
  genus_table <- t(genus_table)
}

# ================================================================
# 6. Assign genus names as column names
# ================================================================
tax_table_df <- as.data.frame(tax_table(ps_genus_relab))

genus_names <- tax_table_df$Genus

# Replace NA genus names
genus_names[is.na(genus_names)] <- "Unclassified"

# Assign names
colnames(genus_table) <- genus_names

# ================================================================
# 7. Handle duplicate genus names
# ================================================================
colnames(genus_table) <- make.unique(colnames(genus_table))

