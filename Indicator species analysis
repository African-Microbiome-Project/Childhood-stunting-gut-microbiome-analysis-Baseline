# Load the necessary libraries
library(phyloseq)
library(dplyr)
library(tidyr)

# Assuming your phyloseq object is named 'ps'
# 1. Define base directory and load rarefied phyloseq object

base_dir <- "C:/Users/kayle/Combined_Sep_data/Kaylee results"
ps <- readRDS(file.path(base_dir, "Merged_rarefied_Informal.rds"))

# Save the abundance table to a CSV file

abundance_table <- as.data.frame(otu_table(ps))
write.csv(abundance_table, "abundance_table.csv")

# Save the taxonomy table to a CSV file

taxonomy_table <- as.data.frame(tax_table(ps))
write.csv(taxonomy_table, "taxonomy_table.csv")


# Transpose the abundance table

abundance_table_t <- t(abundance_table)

# Merge the abundance and taxonomy tables

taxonomy_abundance <- merge(abundance_table_t, taxonomy_table, by = "row.names")
rownames(taxonomy_abundance) <- taxonomy_abundance$Row.names
taxonomy_abundance <- taxonomy_abundance[, -1]

#CHECK IF NOT REPEATED FOR GENUS.

library(dplyr)

# Assuming `taxonomy_abundance` is your data frame
# Identify the taxonomic and numeric columns

taxonomy_columns <- c("Kingdom", "Phylum", "Class", "Order", "Family", "Genus","Species")
numeric_columns <- setdiff(names(taxonomy_abundance), taxonomy_columns)

# Aggregate the data at the genus level

Species_level_df <- taxonomy_abundance %>%
  group_by(Genus) %>%
  summarise(across(all_of(numeric_columns), sum, na.rm = TRUE), .groups = "drop") %>%
  as.data.frame()

# View the aggregated data

print(Species_level_df)

# Save the genus level table to a CSV file
write.csv(Species_level_df, "Genus_level_taxonomy_abundance_data0.0.csv")


