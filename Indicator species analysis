library(ggplot2)

# Choose species to plot

species_name <- "Prevotella_9"

# Prepare data

myDF.plot2 <- data.frame(
  Abundance = taxa.filtered.relab[[species_name]],
  Stunting_status = meta$Stunting_status
)

# Ensure Stunting_status is a factor in the desired order

myDF.plot2$Stunting_status <- factor(myDF.plot2$Stunting_status,
                                     levels = c("Non-stunted", "Stunted"))


# Wilcoxon test (two groups)

wilcox_res <- wilcox.test(Abundance ~ Stunting_status, data = myDF.plot2)
pval <- wilcox_res$p.value

# Print p-value in console

print(paste("Wilcoxon test p-value for", species_name, "=", signif(pval, 4)))

# Format p-value for annotation

pval_label <- if(pval < 0.001) "<0.001" else sprintf("%.3f", pval)

# Set positions for p-value annotation

y_max <- max(myDF.plot2$Abundance, na.rm = TRUE)
y_bar <- y_max * 1.05
y_label <- y_max * 1.1

# Plot

p <- ggplot(myDF.plot2, aes(x = Stunting_status, y = Abundance, fill = Stunting_status)) +
  geom_boxplot(alpha = 0.7, outlier.shape = NA) +
  geom_jitter(width = 0.2, size = 2, alpha = 0.8) +
  scale_fill_manual(
    name = "Stunting status",
    values = c("Non-stunted" = "#B57EDC", "Stunted" = "#FFB347")
  ) +
  theme_bw() +
  labs(
    y = "Relative Abundance (%)",
    x = NULL,
    title = species_name
  ) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(face = "bold"),
    axis.ticks.x = element_blank(),
    legend.position = "right",
    legend.text = element_text(face = "bold"),
    legend.title = element_text(face = "bold"),
    plot.title = element_text(face = "bold", hjust = 0.5)
  ) +
  # Comparison line
  geom_segment(aes(x = 1, xend = 2, y = y_bar, yend = y_bar), linewidth = 0.4) +
  geom_segment(aes(x = 1, xend = 1, y = y_bar, yend = y_bar - (y_max * 0.02)), linewidth = 0.4) +
  geom_segment(aes(x = 2, xend = 2, y = y_bar, yend = y_bar - (y_max * 0.02)), linewidth = 0.4) +
  # Add Wilcoxon p-value
  annotate("text", x = 1.5, y = y_label, label = paste0("p = ", pval_label), size = 4, fontface = "plain")

# Display plot

print(p)

# Save 

out_dir <- "C:/Users/kayle/Combined_Sep_data/Kaylee results/Indicator_Results_plots"

# PDF
pdf(file.path(out_dir, paste0(species_name, "_boxplot.pdf")), width = 8, height = 5)
print(p)
dev.off()

# PNG
png(file.path(out_dir, paste0(species_name, "_boxplot.png")),
    width = 8*600, height = 5*600, res = 600)
print(p)
dev.off()

